    "verify": "bun run scripts/verify-ledger.ts",
    "ryo:capture": "bun run scripts/ryo-capture.ts",
    "ryo:whoami": "bun run scripts/ryo-whoami.ts",
    "ryo:run": "bun run agent/src/ryo/cli.ts",
    "ryo:replay": "bun run agent/src/ryo/cli.ts replay",
