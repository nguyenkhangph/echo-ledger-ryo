# Copy to .env and fill in. Never commit .env.

# RYO-CHAN research layer (MCP). See the MCP Builder Guide on ryobuild.com.
RYO_MCP_URL=
RYO_KEY_ID=
RYO_KEY_ID_HEADER=
RYO_API_KEY=
RYO_API_KEY_HEADER=

# Language model used for extraction and the bull/bear/judge debate (OpenAI-compatible API).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# On-chain record (Ethereum Sepolia) through Chainlink CRE. The private key belongs in cre/.env, never here.
CRE_RECORD_URL=http://localhost:2000
VITE_LEDGER_FROM_BLOCK=11974596
VITE_SEPOLIA_RPC_URL=
VITE_LEDGER_ADDRESS=0x88fd1895d9b4BD28Cf641281b9AA1eF787b8DAd0

# Public address of the dashboard.
VITE_SITE_URL=
